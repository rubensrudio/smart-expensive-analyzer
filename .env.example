# Valores de DESENVOLVIMENTO. Copie para .env (não versionado) e troque a senha fora do ambiente local.
DATABASE_URL=postgresql+psycopg://sea:sea_dev_password@db:5432/sea
DEFAULT_CURRENCY=BRL
MAX_UPLOAD_MB=10
ANOMALY_IQR_K=1.5
ANOMALY_MIN_SAMPLE=8
LOG_LEVEL=INFO

# Usadas só pelo serviço db do Compose.
POSTGRES_USER=sea
POSTGRES_PASSWORD=sea_dev_password
POSTGRES_DB=sea
